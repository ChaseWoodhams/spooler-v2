# Spooler environment variables
# Copy this file to .env and fill in the values.

# ── Network ────────────────────────────────────────────────────────────────────

# Address Spooler listens on (HTTP, HTTPS and live updates). Default 127.0.0.1:
# this machine only. Spooler has no login: setting 0.0.0.0 (all interfaces) or a
# LAN address lets anyone on that network control the printers.
# BIND_HOST=127.0.0.1

# ── Ports ──────────────────────────────────────────────────────────────────────

# HTTP_PORT=8080
# HTTPS_PORT=8443
# WS_PORT=8765

# ── TLS / HTTPS ────────────────────────────────────────────────────────────────

# Set to false when running behind a reverse proxy (Traefik, nginx, Caddy, etc.)
# that handles TLS termination. Disables the built-in self-signed cert and HTTPS server.
# HTTPS_ENABLED=true

# ── Spoolman ───────────────────────────────────────────────────────────────────

# Spoolman API / UI base URL.
# SPOOLMAN_URL=http://localhost:7912

# When true (default), Spoolman's web UI is proxied through /spoolman/ on this
# server so you can access it without leaving the Spooler app.
# When false, the /spoolman link redirects the browser directly to SPOOLMAN_URL
# (better experience — full WebSocket support, no proxy overhead).
# PROXY_SPOOLMAN=true

# ── Backups ────────────────────────────────────────────────────────────────────

# Spooler zips its configuration (DATA_DIR/*.json, *.pem, .env) and SQLite
# databases into BACKUP_DIR on a schedule, and on demand from System health.
# BACKUP_DIR=<DATA_DIR>/backups
# BACKUP_INTERVAL_HOURS=24
# Number of archives to keep (0 keeps all).
# BACKUP_KEEP=14

# Spoolman's SQLite database, to include it in the backups (Spoolman on the same
# machine only). It is copied with SQLite's online-backup API, so this is safe
# while Spoolman is running.
# SPOOLMAN_DB_FILE=/path/to/spoolman/data/spoolman.db

# ── Supervisor (supervisor.py) ─────────────────────────────────────────────────

# Folder holding the Spoolman checkout and its .venv (default: ../spoolman-service).
# SPOOLMAN_SERVICE_DIR=../spoolman-service

# ── Print queue ────────────────────────────────────────────────────────────────

# Largest G-code file that can be uploaded to the queue, in megabytes.
# JOB_MAX_UPLOAD_MB=512

# ── Slicing (OrcaSlicer) ───────────────────────────────────────────────────────

# OrcaSlicer executable used to slice uploaded models. When unset, Spooler looks
# for ../tools/OrcaSlicer-*/orca-slicer.exe next to its own folder.
# ORCA_SLICER_PATH=C:/tools/OrcaSlicer-2.4.2/orca-slicer.exe
# Longest a single slice may run before it is stopped, in seconds.
# SLICE_TIMEOUT_S=900

# ── Splitting large models ─────────────────────────────────────────────────────

# Splitting needs manifold3d, trimesh, numpy, scipy and networkx
# (pip install -r requirements.txt). Each step runs in its own process.
# Largest model that can be uploaded for splitting, in megabytes.
# SPLIT_MAX_UPLOAD_MB=1024
# Longest a single step (analyse, plan, check or split) may run, in seconds.
# SPLIT_STAGE_TIMEOUT_S=3600

# ── Debug ──────────────────────────────────────────────────────────────────────

# Set to 1 to enable verbose MQTT/protocol logging (full payloads, unknown keys).
# DEBUG=0

